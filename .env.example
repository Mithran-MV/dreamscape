# Copy to .env.local and fill in. Never commit real values.

# 0G Private Computer: a scoped sk- key with a daily limit
ZG_API_KEY=
# 0G's own Privy app, for "Sign in with 0G" on localhost:3000 only
NEXT_PUBLIC_ZG_PRIVY_APP_ID=

# Our own Privy app (sign-in and embedded wallets)
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Arkiv access key (keep it on the server)
ARKIV_ACCESS_KEY=
# rabdi (default) or local; ARKIV_RPC_URL overrides that network's URL
ARKIV_NETWORK=
ARKIV_RPC_URL=

# Server and scribe wallets (testnet only)
SERVER_PRIVATE_KEY=
SCRIBE_PRIVATE_KEY=

# Web Push. Generate a pair with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ENS on Sepolia: the parent name (blank means dream-scape.eth) and the NightMarket registrar once it's deployed
ENS_NAME=
NIGHT_MARKET_ADDRESS=
# A local anvil fork of Sepolia for scripts/ens-fork-test.ts, such as http://127.0.0.1:8547
ENS_FORK_RPC_URL=

# The vendor agent: its own key (only the worker uses it), and the dreamer who owns it and is paid
AGENT_PRIVATE_KEY=
VENDOR_OWNER_HANDLE=
# The app's public address, written into each agent's ENS endpoint record
APP_URL=

# RPCs
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
GALILEO_RPC_URL=https://evmrpc-testnet.0g.ai

# Optional: the 0G models for each job, best first. When one can't be served, the next one does the job.
# Reading always runs sealed (private trust), whichever model is listed.
# ZG_READ_MODELS=0gm-1.0-35b-a3b,glm-5.3
# ZG_PAINT_MODELS=z-image-turbo,tencent/hy-image-3.5-preview,bytedance/seedream-5.0-flash,minimax-image-01
# ZG_PANEL_MODELS=tencent/hy-image-3.5-preview,bytedance/seedream-5.0-flash,minimax-image-01
